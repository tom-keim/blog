{
  "name": "Blog",
  "build": {
    "dockerfile": "./Dockerfile"
  },
  "mounts": [
    "source=blog-node-modules,target=/workspaces/blog/node_modules,type=volume"
  ],

  "portsAttributes": {
    "4321": {
      "label": "Application",
      "onAutoForward": "openBrowser"
    }
  },
  "workspaceFolder": "/workspaces/blog",

  "forwardPorts": [4321],

  "postCreateCommand": "sudo chown \"$(id -u):$(id -g)\" /workspaces/blog && sudo chown -R \"$(id -u):$(id -g)\" /workspaces/blog/node_modules && pnpm install && pnpm run build",

  
  "waitFor": "postCreateCommand",

  "postAttachCommand": {
    "Server": "pnpm run dev --host --force"
  },

  "customizations": {
    //"codespaces": {
    //  "openFiles": ["src/pages/index.astro"]
    //},
    "vscode": {
      "extensions": ["astro-build.astro-vscode", "esbenp.prettier-vscode"]
    }
  }
}
